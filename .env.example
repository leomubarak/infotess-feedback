# Neon pooled connection string. Keep this server-side only.
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
# At least 32 random characters, used to sign administrator sessions.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Used only by the one-time admin seed command.
ADMIN_USERNAME=department.admin
ADMIN_PASSWORD=replace-with-a-strong-password
